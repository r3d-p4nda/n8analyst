# Replace every CHANGE_ME value before starting the POC.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
N8N_HOST=n8n.internal.example
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.internal.example/
GENERIC_TIMEZONE=America/New_York

# S3-compatible evidence storage
MINIO_ROOT_USER=n8analyst
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
EVIDENCE_BUCKET=n8analyst-evidence

# Internal service endpoints consumed by workflows
ANALYSIS_API_URL=https://analysis-api.internal.example
MODEL_GATEWAY_URL=https://models.internal.example/v1
JIRA_BASE_URL=https://example.atlassian.net
JIRA_PROJECT_KEY=IR


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n8analyst.local/schemas/finding.schema.json",
  "title": "Agent analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "agent_role", "findings", "limitations"],
  "properties": {
    "status": {"enum": ["completed", "partial", "failed"]},
    "agent_role": {"type": "string", "minLength": 1},
    "model_profile": {"type": "string"},
    "prompt_version": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "classification", "confidence", "severity", "evidence", "alternative_explanations", "recommended_actions"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "classification": {"enum": ["observed_fact", "inference", "hypothesis"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact", "locator", "parser"],
              "properties": {
                "artifact": {"type": "string"},
                "locator": {"type": "string"},
                "parser": {"type": "string"},
                "record_hash": {"type": "string"}
              }
            }
          },
          "alternative_explanations": {"type": "array", "items": {"type": "string"}},
          "recommended_actions": {"type": "array", "items": {"type": "string"}},
          "attack_techniques": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}


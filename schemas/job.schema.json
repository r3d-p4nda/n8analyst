{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n8analyst.local/schemas/job.schema.json",
  "title": "n8analyst analysis job",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "job_type", "priority", "evidence", "scope", "model_policy"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$"},
    "job_type": {"enum": ["network", "host_disk", "host_memory", "combined"]},
    "priority": {"enum": ["low", "medium", "high", "critical"]},
    "idempotency_key": {"type": "string", "maxLength": 256},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence-manifest.schema.json#/$defs/evidenceObject"}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "hosts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "users": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "indicators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "analyst_questions": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "model_policy": {"enum": ["local-only", "no-model"]},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}

